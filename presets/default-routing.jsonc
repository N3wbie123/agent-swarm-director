// ASD v2.5.0 default model routing preset.
// Bootstrapped to ~/.asd/routing.jsonc on first use; per-project
// overrides live in <project>/.asd/routing.jsonc (1st priority).
//
// Role Split:
// 1. "lightSubagents": Used in LIGHT mode (single-harness internal subagent delegation)
//    and PreToolUse hook model overwrites to protect weekly model quotas.
// 2. "agents" & "categories" (or "heavyRouting"): Used in HEAVY mode
//    (external CLI parallel_spawn & cross-harness blind debate).
{
  "_asdVersion": "2.5.0",
  "lightSubagents": {
    "antigravity": {
      "scout": { "model": "flash_lite", "fallbacks": ["flash"] },
      "worker": { "model": "flash", "fallbacks": ["flash_lite", "pro"] },
      "planner": { "model": "flash", "fallbacks": ["pro"] },
      "architect": { "model": "pro", "fallbacks": ["flash"] },
      "critic": { "model": "pro", "fallbacks": ["flash"] },
      "defaultModel": "flash",
      "fallbacks": ["flash_lite"]
    },
    "claude-code": {
      "scout": { "model": "haiku", "fallbacks": ["sonnet"] },
      "worker": { "model": "sonnet", "fallbacks": ["haiku", "opus"] },
      "planner": { "model": "sonnet", "fallbacks": ["opus"] },
      "architect": { "model": "opus", "fallbacks": ["sonnet"] },
      "critic": { "model": "opus", "fallbacks": ["sonnet"] },
      "defaultModel": "sonnet",
      "fallbacks": ["haiku"]
    },
    "opencode": {
      "scout": "z-ai/glm-5.3-flash",
      "worker": "z-ai/glm-5.3-flash",
      "planner": "z-ai/glm-5.3-flash",
      "architect": "z-ai/glm-5.3-flash",
      "critic": "z-ai/glm-5.3-flash",
      "defaultModel": "z-ai/glm-5.3-flash",
      "fallbacks": []
    },
    "codex": {
      "defaultModel": "gpt-5.4",
      "fallbacks": []
    },
    "cursor": {
      "defaultModel": "claude-sonnet-4-6",
      "fallbacks": []
    }
  },
  "agents": {
    "planner": {
      "harness": "claude-code",
      "model": "claude-sonnet-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5.4", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "z-ai/glm-5.3-flash", "modelFamily": "glm" }
      ]
    },
    "architect": {
      "harness": "claude-code",
      "model": "claude-opus-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5.4", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "z-ai/glm-5.3-flash", "modelFamily": "glm" }
      ]
    },
    "worker": {
      "harness": "opencode",
      "model": "z-ai/glm-5.3-flash",
      "modelFamily": "glm",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5.4", "modelFamily": "gpt" },
        { "harness": "antigravity", "model": "gemini-3.8-flash-medium", "modelFamily": "gemini" }
      ]
    },
    "scout": {
      "harness": "antigravity",
      "model": "gemini-3.8-flash-low",
      "modelFamily": "gemini",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5.4", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "z-ai/glm-5.3-flash", "modelFamily": "glm" }
      ]
    },
    "critic": {
      "harness": "codex",
      "model": "gpt-5.4",
      "modelFamily": "gpt",
      "fallbacks": [
        { "harness": "claude-code", "model": "claude-opus-4-6", "modelFamily": "claude" },
        { "harness": "opencode", "model": "z-ai/glm-5.3-flash", "modelFamily": "glm" }
      ]
    }
  },
  "categories": {
    "visual-ui": {
      "harness": "claude-code",
      "model": "claude-sonnet-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "antigravity", "model": "gemini-4-carbon-high", "modelFamily": "gemini" },
        { "harness": "opencode", "model": "z-ai/glm-5.3-flash", "modelFamily": "glm" }
      ]
    },
    "design": {
      "harness": "claude-code",
      "model": "claude-sonnet-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "antigravity", "model": "gemini-4-carbon-high", "modelFamily": "gemini" },
        { "harness": "opencode", "model": "z-ai/glm-5.3-flash", "modelFamily": "glm" }
      ]
    },
    "research": {
      "harness": "opencode",
      "model": "deepseek-ai/deepseek-v3.2",
      "modelFamily": "deepseek",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5.4", "modelFamily": "gpt" },
        { "harness": "claude-code", "model": "claude-sonnet-4-6", "modelFamily": "claude" }
      ]
    },
    "writing": {
      "harness": "codex",
      "model": "gpt-5.4",
      "modelFamily": "gpt",
      "fallbacks": [
        { "harness": "claude-code", "model": "claude-sonnet-4-6", "modelFamily": "claude" },
        { "harness": "opencode", "model": "z-ai/glm-5.3-flash", "modelFamily": "glm" }
      ]
    },
    "general": {
      "harness": "opencode",
      "model": "z-ai/glm-5.3-flash",
      "modelFamily": "glm",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5.4", "modelFamily": "gpt" },
        { "harness": "antigravity", "model": "gemini-3.8-flash-medium", "modelFamily": "gemini" }
      ]
    },
    "low": {
      "harness": "antigravity",
      "model": "gemini-3.8-flash-medium",
      "modelFamily": "gemini",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5.4", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "z-ai/glm-5.3-flash", "modelFamily": "glm" }
      ]
    },
    "medium": {
      "harness": "opencode",
      "model": "z-ai/glm-5.3-flash",
      "modelFamily": "glm",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5.4", "modelFamily": "gpt" },
        { "harness": "claude-code", "model": "claude-sonnet-4-6", "modelFamily": "claude" }
      ]
    },
    "high": {
      "harness": "claude-code",
      "model": "claude-sonnet-4-6",
      "modelFamily": "claude",
      "fallbacks": [
        { "harness": "codex", "model": "gpt-5.4", "modelFamily": "gpt" },
        { "harness": "opencode", "model": "z-ai/glm-5.3-flash", "modelFamily": "glm" }
      ]
    }
  }
}
